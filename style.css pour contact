/* --- STYLES SPECIFIQUES CONTACT --- */
.contact-container {
    padding: 2rem 8% 6rem;
    max-width: 1200px;
    margin: 0 auto;
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
}

.contact-link {
    color: var(--primary); /* L'adresse mail sera en bleu indigo moderne */
    font-weight: 700;
    font-size: 1.1rem;
    word-break: break-all; /* Évite que l'email dépasse sur mobile */
    transition: 0.3s;
}

.contact-link:hover {
    text-decoration: underline;
    opacity: 0.8;
}

/* On s'assure que les icônes de contact ressortent bien */
.contact-grid .hub-icon {
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary);
}
